# easybook — configuration de **production**.
#
#   cp docker/.env.example docker/.env
#   docker compose -f docker/docker-compose.yml up -d
#
# Ce fichier est le seul lu par `docker/docker-compose.yml` : le `.env` de
# développement (racine du dépôt) n'a aucun effet ici. `.env` n'est pas versionné
# (`.gitignore`), `.env.example` l'est.

# ── Réseau ────────────────────────────────────────────────────────────────
# Port publié sur l'hôte (nginx : interface + API sur la même origine).
EASYBOOK_PORT=5100

# ── Bibliothèque ──────────────────────────────────────────────────────────
# Dossier des livres **sur l'hôte**, relatif à `docker/` (donc `docker/books`
# par défaut) ou absolu (`/srv/easybook/books`). Le conteneur y écrit : sous
# Linux, il doit appartenir à l'uid 1000 (`chown -R 1000:1000 books`).
EASYBOOK_BOOKS=./books

# ── Administrateur ────────────────────────────────────────────────────────
# Créé au premier démarrage seulement (base de comptes vide). Laisser le mot de
# passe vide pour le tirer au hasard : il est alors affiché **une seule fois**
# dans `docker logs easybook`. Le changer ensuite depuis la page Comptes.
EASYBOOK_ADMIN_EMAIL=
EASYBOOK_ADMIN_PASSWORD=

# ── Single sign-on OpenID Connect (facultatif) ────────────────────────────
# Vide = désactivé. `ISSUER` est l'adresse vue par le navigateur ; `DISCOVERY_URL`
# celle que joint easybook (vide : l'émetteur), utile quand le fournisseur n'est
# pas joignable sous le même nom depuis le conteneur.
EASYBOOK_OIDC_ISSUER=
EASYBOOK_OIDC_DISCOVERY_URL=
EASYBOOK_OIDC_CLIENT_ID=
EASYBOOK_OIDC_CLIENT_SECRET=
# Adresse de retour enregistrée chez le fournisseur (vide : déduite de la requête).
EASYBOOK_OIDC_REDIRECT_URL=
EASYBOOK_OIDC_LABEL=Single sign-on
# Politique de liaison d'un utilisateur OIDC inconnu, dans cet ordre :
# `link_by_email` (compte local de même adresse certifiée), puis
# `auto_create` (compte sans mot de passe), sinon refus tant qu'un
# administrateur ne l'a pas lié (page Comptes).
EASYBOOK_OIDC_AUTO_CREATE=true
EASYBOOK_OIDC_LINK_BY_EMAIL=true
# `true` : chaque personne connectée peut lier elle-même son compte à une
# identité du fournisseur ; sinon, réservé aux administrateurs.
EASYBOOK_OIDC_SELF_LINK=false
