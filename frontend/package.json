		"svelte": "^5.30.0",
		"svelte-check": "^4.2.0",
		"typescript": "^5.8.0",
		"vite": "^7.0.0",
		"vitest": "^4.0.0"
	},
	"dependencies": {
		"@dicebear/core": "9",
		"@dicebear/fun-emoji": "^9.4.2",
		"@tanstack/svelte-table": "^9.3.2",
