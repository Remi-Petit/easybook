# Configuration de DÉVELOPPEMENT du docker-compose.yml :
#
#   docker compose --env-file .env.dev up -d --build
#
# Sans ce fichier, le compose est en production : pas de Keycloak, pas de
# connexion directe, administrateur au mot de passe aléatoire. Valeurs de test
# seulement — jamais en production.

# Lance le conteneur Keycloak de test (profil `dev`).
COMPOSE_PROFILES=dev
EASYBOOK_MODE=dev

# Connexion : admin@easybook.local / admin-dev-1234
EASYBOOK_ADMIN_EMAIL=admin@easybook.local
EASYBOOK_ADMIN_PASSWORD=admin-dev-1234

# Keycloak (realm `easybook`, docker/keycloak/easybook-realm.json) : alice@example.org,
# bob@example.org, carol@example.org — mot de passe = prénom en minuscules.
EASYBOOK_OIDC_ISSUER=http://localhost:8180/realms/easybook
EASYBOOK_OIDC_DISCOVERY_URL=http://keycloak:8080/realms/easybook
EASYBOOK_OIDC_CLIENT_ID=easybook
EASYBOOK_OIDC_CLIENT_SECRET=easybook-test-secret
EASYBOOK_OIDC_LABEL=Keycloak
# En développement, un compte Keycloak se crée à la première connexion.
EASYBOOK_OIDC_AUTO_CREATE=true

# Boutons « connexion rapide » de la page de connexion (e-mail:mot de passe). Les
# mots de passe restent dans le serveur ; le navigateur ne reçoit que les e-mails.
EASYBOOK_DEV_LOGINS=admin@easybook.local:admin-dev-1234,alice@example.org:alice,bob@example.org:bob,carol@example.org:carol
